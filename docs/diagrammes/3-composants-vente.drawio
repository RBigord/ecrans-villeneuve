ry relative="1" as="geometry" /></mxCell><mxCell id="a_reservation_trait" value="" style="endArrow=none;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;strokeColor=#111827;fontColor=#111827;labelBackgroundColor=#FFFFFF;" parent="1" source="a_reservation" target="s_reserver" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="x_horloge" value="«external»&lt;br&gt;&lt;b&gt;Horloge&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:11px'&gt;chaque minute&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;dashed=1;strokeColor=#111827;fontColor=#111827;fillColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="-420" y="362" width="170" height="56" as="geometry" /></mxCell><mxCell id="a_expiration" value="«component»&lt;br&gt;&lt;b&gt;ExpirationPlanifiee&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:11px'&gt;@Scheduled · chaque minute (B2)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;strokeColor=#111827;fontColor=#111827;fillColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="30" y="362" width="190" height="56" as="geometry" /></mxCell><mxCell id="s_expirer" value="" style="shape=requiredInterface;html=1;direction=west;strokeColor=#111827;fontColor=#111827;" parent="1" vertex="1"><mxGeometry x="352" y="375" width="12" height="30" as="geometry" /></mxCell><mxCell id="x_horloge_reveil" value="" style="html=1;rounded=0;endArrow=open;endFill=0;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#111827;fontColor=#111827;labelBackgroundColor=#FFFFFF;" parent="1" source="x_horloge" target="a_expiration" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_expiration_trait" value="" style="endArrow=none;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;strokeColor=#111827;fontColor=#111827;labelBackgroundColor=#FFFFFF;" parent="1" source="a_expiration" target="s_expirer" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p_partenaire" value="EnregistrerVentePartenaire" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=11;labelPosition=left;verticalLabelPosition=top;align=right;verticalAlign=bottom;strokeColor=#111827;fontColor=#111827;fillColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="360" y="480" width="20" height="20" as="geometry" /></mxCell><mxCell id="p_partenaire_trait" value="" style="endArrow=none;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7167;entryDx=0;entryDy=0;strokeColor=#111827;fontColor=#111827;labelBackgroundColor=#FFFFFF;" parent="1" source="p_partenaire" target="3" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="x_sortiesflash" value="«external»&lt;br&gt;&lt;b&gt;SortiesFlash&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:11px'&gt;vente déjà payée, son format&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;dashed=1;strokeColor=#111827;fontColor=#111827;fillColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="-420" y="462" width="170" height="56" as="geometry" /></mxCell><mxCell id="a_sf_ctrl" value="«component»&lt;br&gt;&lt;b&gt;SortiesFlashController&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:11px'&gt;HTTP · POST /partner/v2/orders&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;strokeColor=#111827;fontColor=#111827;fillColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="-210" y="462" width="200" height="56" as="geometry" /></mxCell><mxCell id="a_acl_sf" value="«component»&lt;br&gt;&lt;b&gt;AclSortiesFlash&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:11px'&gt;ACL : ADULT → PLEIN… (B11)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;strokeColor=#111827;fontColor=#111827;fillColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="30" y="462" width="190" height="56" as="geometry" /></mxCell><mxCell id="s_partenaire" value="" style="shape=requiredInterface;html=1;direction=west;strokeColor=#111827;fontColor=#111827;" parent="1" vertex="1"><mxGeometry x="352" y="475" width="12" height="30" as="geometry" /></mxCell><mxCell id="x_sortiesflash_appel" value="" style="html=1;rounded=0;endArrow=open;endFill=0;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#111827;fontColor=#111827;labelBackgroundColor=#FFFFFF;" parent="1" source="x_sortiesflash" target="a_sf_ctrl" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_sf_ctrl_vers_acl" value="" style="html=1;rounded=0;endArrow=open;endFill=0;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#111827;fontColor=#111827;labelBackgroundColor=#FFFFFF;" parent="1" source="a_sf_ctrl" target="a_acl_sf" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_acl_sf_trait" value="" style="endArrow=none;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;strokeColor=#111827;fontColor=#111827;labelBackgroundColor=#FFFFFF;" parent="1" source="a_acl_sf" target="s_partenaire" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_spring_config" value="«component»&lt;br&gt;&lt;b&gt;VenteConfiguration&lt;/b&gt;&lt;br&gt;&lt;i style='font-size:11px'&gt;@Configuration Spring : publie les ports d'ApplicationVente comme beans&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FCE7F3;strokeColor=#BE185D;fontColor=#111827;" parent="1" vertex="1"><mxGeometry x="30" y="580" width="190" height="90" as="geometry" /></mxCell><mxCell id="legende" value="&lt;b&gt;Légende&lt;/b&gt;&lt;br&gt;○ rond = interface fournie (« je propose ») · ( demi-cercle = interface requise (« j'ai besoin ») · un demi-cercle autour d'un rond = assemblage&lt;br&gt;À gauche : les ports primaires (application/port/in), fournis par l'hexagone. À droite : les ports secondaires (application/port/out), requis par l'hexagone et fournis par les adapters.&lt;br&gt;Flèche pointillée = dépendance « utilise », toujours vers l'intérieur. Noms identiques au code de code/vente/.&lt;br&gt;ApplicationVente (en rose) est la composition root : seul composant qui connaît à la fois les adapters et les services, donc dessiné hors de l'hexagone.&lt;br&gt;Étape 6 : ReserverDesPlacesService passe par le port GrilleTarifaire, jamais par l'adapter GrilleTarifaireFixe. En pointillés à droite : les systèmes réels derrière chaque adapter.&lt;br&gt;Étapes 7 et 8 : les contrôleurs Spring (REST, webhook PayVia, SortiesFlash) et le planificateur se branchent sur des ports qui existaient déjà ; seul EnregistrerVentePartenaire est un nouveau port. Le format de SortiesFlash reste enfermé dans son ACL. VenteConfiguration publie les ports d'ApplicationVente comme beans Spring." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;strokeColor=#111827;spacing=8;rounded=0;fontColor=#111827;" parent="1" vertex="1">
          <mxGeometry x="-420" y="690" width="1950" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>