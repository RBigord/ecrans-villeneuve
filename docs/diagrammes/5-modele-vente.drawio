<mxfile host="app.diagrams.net">
  <diagram name="5-modele-vente" id="5-modele-vente">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titre" value="Quels agrégats protègent les règles de la vente ?" vertex="1" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;">
          <mxGeometry x="40" y="20" width="1420" height="40" as="geometry" />
        </mxCell>
        <mxCell id="st" value="Modèle du contexte Vente (code/vente/domaine) · jaune foncé = racine d'agrégat · jaune clair = élément interne · bleu = value object · orange = événement · rouge = invariant protégé. Les deux agrégats ne se référencent que par identité." style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="1400" height="22" as="geometry" />
        </mxCell>
        <mxCell id="cadre-seance" value="" style="rounded=1;arcSize=8;strokeWidth=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B8962E;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=#000000;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="100" width="640" height="560" as="geometry" />
        </mxCell>
        <mxCell id="t-seance" value="Agrégat Seance  (domaine/seance)" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="104" width="400" height="22" as="geometry" />
        </mxCell>
        <mxCell id="seance" value="«aggregate root» Seance&lt;br&gt;—&lt;br&gt;id : SeanceId&lt;br&gt;debut : LocalDateTime&lt;br&gt;places : Map&lt;PlaceId, EtatPlace&gt;&lt;br&gt;version : long&lt;br&gt;—&lt;br&gt;bloquer(places, commande, maintenant)&lt;br&gt;vendre(commande, places, maintenant)&lt;br&gt;libererBlocagesExpires(maintenant)&lt;br&gt;venteOuverteA(maintenant)" style="rounded=1;arcSize=8;strokeWidth=1;whiteSpace=wrap;html=1;fillColor=#FFE38A;strokeColor=#B8962E;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;fontColor=#000000;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="etat" value="«value object» EtatPlace&lt;br&gt;—&lt;br&gt;statut : StatutPlace (LIBRE, BLOQUEE, VENDUE)&lt;br&gt;commande : CommandeId&lt;br&gt;jusqua : LocalDateTime&lt;br&gt;—&lt;br&gt;estLibreA(t), blocageExpireA(t)" style="rounded=1;arcSize=8;strokeWidth=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#6C8EBF;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;fontColor=#000000;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="390" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="placeid" value="«value object» PlaceId (rang + numéro, ex. G7)" style="rounded=1;arcSize=8;strokeWidth=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#6C8EBF;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;fontColor=#000000;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="inv-seance" value="Invariants protégés&lt;br&gt;&lt;br&gt;B1 : une place n'est vendue qu'une fois (tous canaux)&lt;br&gt;&lt;br&gt;B2 : blocage de 10 min, puis libération&lt;br&gt;&lt;br&gt;B4 : vente fermée 15 min après le début&lt;br&gt;&lt;br&gt;Tout ou rien : si une place est prise, aucune n'est bloquée&lt;br&gt;&lt;br&gt;Concurrence : version (verrou optimiste, ADR-0002)" style="rounded=1;arcSize=8;strokeWidth=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#E06666;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;fontColor=#000000;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="400" y="215" width="250" height="330" as="geometry" />
        </mxCell>
        <mxCell id="cadre-cmd" value="" style="rounded=1;arcSize=8;strokeWidth=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B8962E;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=#000000;spacing=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="100" width="710" height="560" as="geometry" />
        </mxCell>
        <mxCell id="t-cmd" value="Agrégat Commande  (domaine/commande)" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="770" y="104" width="400" height="22" as="geometry" />
        </mxCell>
        <mxCell id="commande" value="«aggregate root» Commande&lt;br&gt;—&lt;br&gt;id : CommandeId&lt;br&gt;seance : SeanceId&lt;br&gt;billets : List&lt;Billet&gt; (1 à 10)&lt;br&gt;expireA : LocalDateTime&lt;br&gt;statut : StatutCommande&lt;br&gt;evenements : List&lt;EvenementVente&gt;&lt;br&gt;—&lt;br&gt;creer(…), total(), payer(t), expirer(t), retirerEvenements()" style="rounded=1;arcSize=8;strokeWidth=1;whiteSpace=wrap;html=1;fillColor=#FFE38A;strokeColor=#B8962E;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;fontColor=#000000;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="790" y="140" width="320" height="210" as="geometry" />
        </mxCell>
        <mxCell id="billet" value="«entity / VO» Billet&lt;br&gt;place : PlaceId · tarif : Tarif" style="rounded=1;arcSize=8;strokeWidth=1;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#B8962E;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;fontColor=#000000;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="790" y="400" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tarif" value="«value object» Tarif&lt;br&gt;categorie : Categorie · prix : Montant (figé, B6)" style="rounded=1;arcSize=8;strokeWidth=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#6C8EBF;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;fontColor=#000000;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="790" y="500" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="statut" value="StatutCommande : EN_ATTENTE_PAIEMENT → PAYEE | EXPIREE | A_REMBOURSER" style="rounded=1;arcSize=8;strokeWidth=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#6C8EBF;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;fontColor=#000000;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="790" y="590" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="inv-cmd" value="Invariants protégés&lt;br&gt;&lt;br&gt;B3 : 1 à 10 places, d'une même séance, sans doublon&lt;br&gt;&lt;br&gt;B6 : le total = somme des prix figés à la réservation&lt;br&gt;&lt;br&gt;On ne paie pas deux fois ; une commande payée n'expire pas (TransitionInterdite)&lt;br&gt;&lt;br&gt;B13 : une commande expirée peut encore être payée" style="rounded=1;arcSize=8;strokeWidth=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#E06666;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;fontColor=#000000;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1150" y="140" width="300" height="300" as="geometry" />
        </mxCell>
        <mxCell id="t-ev" value="Événements enregistrés par Commande, publiés par l'application APRÈS l'enregistrement" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="900" height="22" as="geometry" />
        </mxCell>
        <mxCell id="ev1" value="CommandePayee&lt;br&gt;(commande, seance, places, total)&lt;br&gt;→ Notification, Contrôle d'accès, Déclarations" style="rounded=1;arcSize=8;strokeWidth=1;whiteSpace=wrap;html=1;fillColor=#FCE0CC;strokeColor=#F0A060;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;fontColor=#000000;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ev2" value="CommandeExpiree&lt;br&gt;(commande, seance)&lt;br&gt;→ fin du parcours « personne ne paie »" style="rounded=1;arcSize=8;strokeWidth=1;whiteSpace=wrap;html=1;fillColor=#FCE0CC;strokeColor=#F0A060;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;fontColor=#000000;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="400" y="730" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ev3" value="PaiementARembourser&lt;br&gt;(commande, montant)&lt;br&gt;→ une policy rembourse via PayVia (B13, B10)" style="rounded=1;arcSize=8;strokeWidth=1;whiteSpace=wrap;html=1;fillColor=#FCE0CC;strokeColor=#F0A060;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;fontColor=#000000;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="760" y="730" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ev4" value="VentePartenaireEnregistree (étape 8)&lt;br&gt;(commande, partenaire, montant payé)&lt;br&gt;→ Déclarations et reversements (B11)" style="rounded=1;arcSize=8;strokeWidth=1;whiteSpace=wrap;html=1;fillColor=#FCE0CC;strokeColor=#F0A060;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;fontColor=#000000;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1120" y="730" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="vo" value="Autres value objects (domaine/commun) : SeanceId, CommandeId, PlaceId, Montant (centimes, plus(), « 18,00 € ») · Categorie (PLEIN, REDUIT, ENFANT, MATIN, ABONNE) · Exceptions métier (ErreurMetier) : PlacesIndisponibles, PlaceInconnue, VenteFermee, TropDePlaces, CommandeVide, PlaceEnDouble, TransitionInterdite." style="rounded=1;arcSize=8;strokeWidth=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;fontColor=#000000;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="860" width="1420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="" style="html=1;rounded=0;endArrow=block;strokeWidth=1.5;strokeColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=11;" edge="1" parent="1" source="seance" target="etat">
